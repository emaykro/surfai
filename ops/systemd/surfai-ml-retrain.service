[Unit]
Description=SURFAI weekly ML retrain (cluster refit + train + full rescore)
After=network.target postgresql.service
Wants=postgresql.service
# Don't collide with the 5-minute scoring pass while artifacts are rewritten.
Conflicts=surfai-ml-score.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/surfai
EnvironmentFile=/opt/surfai/.env
ExecStart=/opt/surfai/ops/ml-retrain.sh
# cluster --all + train + score --all on the full table; generous ceiling.
TimeoutStartSec=3600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=surfai-ml-retrain
